<sdf version='1.6'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>200</range></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 回环走廊: 外圈 60x40m, 内圈 52x32m, 走廊宽 4m -->
    <!-- 每段墙: 长度 厚度 高度, 位置 x y z, 绕 Z 旋转 -->

    <!-- 外墙 -->
    <model name='outer_walls'>
      <static>1</static>
      <link name='bottom'><pose>0 -20 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>60 0.2 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>60 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='top'><pose>0 20 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>60 0.2 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>60 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='left'><pose>-30 0 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 40 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 40 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='right'><pose>30 0 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 40 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 40 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 内墙 -->
    <model name='inner_walls'>
      <static>1</static>
      <link name='bottom'><pose>0 -16 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>52 0.2 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>52 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='top'><pose>0 16 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>52 0.2 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>52 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='left'><pose>-26 0 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 32 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 32 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='right'><pose>26 0 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 32 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 32 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 延伸走廊 (北侧 30m 死胡同) -->
    <model name='ext_corridor'>
      <static>1</static>
      <link name='left'><pose>-2 31 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 30 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 30 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
      <link name='right'><pose>2 31 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 30 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>0.2 30 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name='ext_end'><static>1</static>
      <link name='link'><pose>0 46 0 0 0 0</pose>
        <collision name='c'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry><surface><contact><ode/></contact></surface></collision>
        <visual name='v'><pose>0 0 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 庭院内放些彩色方块 -->
    <model name='block_1'><static>1</static>
      <pose>-8 6 0 0 0 0</pose>
      <link name='l'><pose>0 0 0.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name='block_2'><static>1</static>
      <pose>10 -8 0 0 0 0</pose>
      <link name='l'><pose>0 0 0.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name='block_3'><static>1</static>
      <pose>-15 -12 0 0 0 0</pose>
      <link name='l'><pose>0 0 0.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name='block_4'><static>1</static>
      <pose>16 10 0 0 0 0</pose>
      <link name='l'><pose>0 0 0.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -35 30 0 0.92 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
