# 复制成 .env.local 后填写（.env.local 不会提交）
#
# 唯一数据通道：debug_bridge（WebSocket + protobuf），默认端口 9100
# VITE_BRIDGE_URL=ws://192.168.1.100:9100/
#
# 远程隧道（https 页面下必须用 wss）
# VITE_BRIDGE_URL=wss://test.rosiwit.com/remote-terminal/tunnel/<SN>/<TOKEN>/127.0.0.1/9100/
# VITE_TUNNEL_URL=wss://test.rosiwit.com/remote-terminal/tunnel/<SN>/<TOKEN>/127.0.0.1/9100/
