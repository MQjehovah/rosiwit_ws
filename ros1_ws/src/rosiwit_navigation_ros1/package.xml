<?xml version="1.0"?>
<package format="2">
  <name>rosiwit_navigation_ros1</name>
  <version>1.0.0</version>
  <description>
    ROS1 thin interface for rosiwit_navigation. Bridges ROS1 topics/services to the
    ROS-agnostic navigation algorithm core (shared with rosiwit_navigation_ros2).
  </description>
  <maintainer email="ai-dev-team@example.com">AI Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
</package>
