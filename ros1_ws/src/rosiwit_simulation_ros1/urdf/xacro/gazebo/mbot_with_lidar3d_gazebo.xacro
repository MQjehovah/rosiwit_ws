<?xml version="1.0"?>
<robot name="mbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        Combined model: mbot_base + 3D LiDAR (VLP-16) + IMU (ROS1)
        This is the ROS1 equivalent of the default model used by
        rosiwit_simulation_ros2's simulator_gazebo launch.
    -->

    <xacro:include filename="$(find rosiwit_simulation_ros1)/urdf/xacro/gazebo/mbot_base.xacro" />
    <xacro:include filename="$(find rosiwit_simulation_ros1)/urdf/xacro/sensors/lidar3d_gazebo.xacro" />
    <xacro:include filename="$(find rosiwit_simulation_ros1)/urdf/xacro/sensors/imu_gazebo.xacro" />

    <!-- lidar_plugin: block (default, gazebo_plugins built-in) | velodyne
         velodyne needs ros-melodic-velodyne-gazebo-plugins for a more faithful
         VLP-16 cloud; both publish on the same topic/frame.
         Keep this file ASCII-only (Python 2 URDF parsers). -->
    <xacro:arg name="lidar_plugin" default="block"/>

    <xacro:lidar3d_gazebo prefix="lidar" plugin="$(arg lidar_plugin)"/>
    <xacro:imu prefix="imu"/>

    <xacro:mbot_base/>

</robot>
