<?xml version="1.0" ?>
<!-- 0.80 m 门洞 = 碰撞体宽 0.70 m + 10 cm (窄通道验收口径: 车宽 + 10cm).
     两道墙在 y=3.0 处留 gap x in [-0.40, 0.40].
     车体碰撞体: 0.87 x 0.70, x 偏移 0.119 (见 gt_robot.xacro)
     机器人起点 (0,0) 朝 +y, 目标 (0,3.8). -->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="wall_left">
      <static>1</static>
      <pose>-2.7 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.6 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.6 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="wall_right">
      <static>1</static>
      <pose>2.7 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.6 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.6 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>


    <model name="wall_back">
      <static>1</static>
      <pose>0.0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>


    <!-- 起点走廊侧墙: 空世界里几乎没有回波, 地图会全 unknown -> 规划器拒绝起步 -->
    <model name="side_left">
      <static>1</static>
      <pose>-1.5 0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 5.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="side_right">
      <static>1</static>
      <pose>1.5 0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 5.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>
