<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Person placeholder: a 0.5 x 0.3 x 1.7 m box, model origin on the ground.
       Used only by the simulation to give the perception node a detectable target;
       sim_person_detector.py publishes 2D boxes for models with the same name. -->
  <model name="person_box">
    <static>true</static>
    <link name="body">
      <pose>0 0 0.85 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.3 1.7</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.25 0.20 1</ambient>
          <diffuse>0.85 0.25 0.20 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
