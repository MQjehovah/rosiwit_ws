<?xml version="1.0"?>
<launch>
  <!--
    ROS1 仿真一键启动: Gazebo + SLAM + 导航

      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch gui:=false          # 无 Gazebo GUI (RViz 仍开)
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch rviz:=false         # 无 RViz
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch use_drive:=true     # 自动跑图建图
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch world_name:=$(rospack find rosiwit_simulation_ros1)/world/large.world

    组成:
      rosiwit_simulation_ros1/simulator_gazebo.launch   Gazebo 世界 + 实机模型 (32 线 3D 雷达 + IMU + 差速插件)
      rosiwit_slam_ros1/slam_simulation.launch          SLAM  (map->odom, /map, /lio_odom, /world_cloud)
      rosiwit_navigation_ros1/navigation_simulation.launch  导航 (吃 /map + /lio_odom + /world_cloud)
      rosiwit_simulation_ros1/sim_drive.py              可选: 建图用的自动运动脚本
      rviz                                              可选: rviz/sim_slam_nav.rviz

    发目标:
      rostopic pub -1 /goal_pose geometry_msgs/PoseStamped \
        '{header: {frame_id: map}, pose: {position: {x: 3.0, y: 0.0}, orientation: {w: 1.0}}}'
      或在 RViz 里用 2D Nav Goal (话题 /move_base_simple/goal)。

    说明:
      * 三个节点同时启动。Gazebo 先发 /clock, SLAM/导航在收到数据前保持空闲,
        不需要额外的定时器错开。
      * 启动后等 /map 和 /lio_odom 稳定 (约 5s) 再发目标, 否则导航可能已经
        接受目标但还没有可用的 costmap。
      * SLAM 刚启动的几十毫秒内会报几次
        `"odom" ... lookupTransform ... does not exist` —— 这是 Gazebo 还没
        发出 odom->base_footprint 的正常启动瞬态, 出现 map->odom 后自动消失。
      * use_drive 与手动 nav goal 不要同时用: 两者都往 /cmd_vel 发速度。
  -->
  <!-- Scenes: house | parking | supermarket | school | hospital -->
  <arg name="scene" default="house"/>
  <arg name="world_name" default="$(find rosiwit_simulation_ros1)/world/$(arg scene).world"/>
  <!-- MPPI/代价地图的 OpenMP 默认会吃满所有核, 限制到 2 线程, 避免和 Gazebo 抢 CPU -->
  <env name="OMP_NUM_THREADS" value="2"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <!-- 出生位姿可覆盖；容器里按场景给值（见 images/sim-gazebo-ros1/entrypoint.sh），
       ROS1 的 roslaunch 没有 $(eval)，做不了 scene -> 坐标的条件，所以放外面算。 -->
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="0.1"/>
  <arg name="spawn_yaw" default="0.0"/>
  <!-- 行人初始位姿：同样由 entrypoint 按场景算好传进来，默认值就是老行为 -->
  <arg name="person1_x" default="3.5"/>
  <arg name="person1_y" default="1.2"/>
  <arg name="person2_x" default="4.0"/>
  <arg name="person2_y" default="-0.6"/>
  <arg name="person3_x" default="5.0"/>
  <arg name="person3_y" default="1.2"/>
  <arg name="robot_name" default="mrobot"/>
  <!-- 3D 雷达插件实现: velodyne (默认, 包内自带 .so) | block (melodic 自带) -->
  <arg name="lidar_plugin" default="velodyne"/>

  <!-- 仿真参数文件 (可在命令行覆盖) -->
  <arg name="slam_config" default="$(find rosiwit_slam_ros1)/config/simulation.yaml"/>
  <arg name="navigation_config" default="$(find rosiwit_navigation_ros1)/config/simulation.yaml"/>

  <!-- 定位模式: map 为空 = 纯建图; 非空 = 载入该地图 (优先目录下的 map.yaml)。 -->
  <arg name="map" default=""/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_yaw" default="0.0"/>

  <!-- RViz: 固定 map 系, 显示 /map、/world_cloud、/global_path、/local_path、TF、车模;
       2D Nav Goal 发 /move_base_simple/goal, 2D Pose Estimate 发 /initialpose。 -->
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find rosiwit_starter_ros1)/rviz/sim_slam_nav.rviz"/>

  <!-- 可选: 自动运动 (建图用), figure8|circle|square|explore -->
  <!-- Perception: front depth camera + person models + GT detector + object_semantics.
       Enabled by default; disable with enable_perception:=false.
       For a clean demo use the open world (ground plane, no walls):
         world_name:=$(find rosiwit_simulation_ros1)/world/perception.world -->
  <arg name="enable_perception" default="true"/>
  <arg name="perception_detector" default="external"/>
  <arg name="perception_config"
       default="$(find rosiwit_perception_ros1)/config/sim_object_semantics.yaml"/>
  <arg name="person_models" default="person_1,person_2,person_3"/>

  <arg name="use_drive" default="false"/>
  <arg name="drive_mode" default="figure8"/>
  <arg name="drive_linear_speed" default="0.3"/>
  <arg name="drive_angular_speed" default="0.5"/>
  <arg name="drive_duration" default="120.0"/>

  <!-- Force Gazebo down on Ctrl+C: the openni depth camera can
       hang the normal Gazebo shutdown on WSL. -->
  <node pkg="rosiwit_simulation_ros1" type="sim_shutdown_guard.py"
        name="sim_shutdown_guard" output="screen"/>

  <!-- 1. Gazebo + 机器人描述 + spawn -->
  <include file="$(find rosiwit_simulation_ros1)/launch/simulator_gazebo.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="spawn_z" value="$(arg spawn_z)"/>
    <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="lidar_plugin" value="$(arg lidar_plugin)"/>
  </include>

  <!-- 1.5 感知: 行人占位模型 + 真值 2D 检测 + 3D 语义输出 -->
  <!-- 行人的 spawn 坐标由 entrypoint 按场景算好传入（默认就是原点附近的老布局） -->
  <node if="$(arg enable_perception)" pkg="gazebo_ros" type="spawn_model"
        name="spawn_person_1" output="screen"
        args="-sdf -file $(find rosiwit_simulation_ros1)/models_perception/person_walking/model.sdf
              -model person_1 -x $(arg person1_x) -y $(arg person1_y) -z 0.02"/>
  <node if="$(arg enable_perception)" pkg="gazebo_ros" type="spawn_model"
        name="spawn_person_2" output="screen"
        args="-sdf -file $(find rosiwit_simulation_ros1)/models_perception/person_walking/model.sdf
              -model person_2 -x $(arg person2_x) -y $(arg person2_y) -z 0.02"/>
  <node if="$(arg enable_perception)" pkg="gazebo_ros" type="spawn_model"
        name="spawn_person_3" output="screen"
        args="-sdf -file $(find rosiwit_simulation_ros1)/models_perception/person_walking/model.sdf
              -model person_3 -x $(arg person3_x) -y $(arg person3_y) -z 0.02"/>

  <!-- openni 插件只给图像 camera_info 打光学系名, 不保证发 TF; 这里补上
       camera_01_link -> 光学系 的静态变换 (yaw/pitch/roll 顺序) -->
  <node if="$(arg enable_perception)" pkg="tf" type="static_transform_publisher"
        name="camera_01_optical_tf"
        args="0 0 0 -1.5707963 0 -1.5707963 camera_01_link camera_01_color_optical_frame 100"/>
  <node if="$(arg enable_perception)" pkg="tf" type="static_transform_publisher"
        name="camera_01_depth_optical_tf"
        args="0 0 0 -1.5707963 0 -1.5707963 camera_01_link camera_01_depth_optical_frame 100"/>

  <node if="$(arg enable_perception)" pkg="rosiwit_simulation_ros1"
        type="sim_person_detector.py" name="sim_person_detector" output="screen">
    <param name="robot_name" value="$(arg robot_name)"/>
    <param name="model_names" value="$(arg person_models)"/>
    <param name="color_topic" value="/camera_01/color/image_raw"/>
    <param name="camera_info_topic" value="/camera_01/color/camera_info"/>
    <param name="output_topic" value="/perception/objects/detections_2d"/>
  </node>

  <node if="$(arg enable_perception)" pkg="rosiwit_simulation_ros1"
        type="sim_people_mover.py" name="sim_people_mover" output="screen">
    <param name="model_names" value="$(arg person_models)"/>
    <param name="center_x" value="$(arg spawn_x)"/>
    <param name="center_y" value="$(arg spawn_y)"/>
  </node>

  <include if="$(arg enable_perception)"
           file="$(find rosiwit_perception_ros1)/launch/object_semantics.launch">
    <arg name="config" value="$(arg perception_config)"/>
    <arg name="detector" value="$(arg perception_detector)"/>
  </include>

  <!-- 2. SLAM: 建图模式, 发布 /map + /lio_odom + /world_cloud -->
  <include file="$(find rosiwit_slam_ros1)/launch/slam_simulation.launch">
    <arg name="config_file" value="$(arg slam_config)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="map" value="$(arg map)"/>    <arg name="initial_x" value="$(arg initial_x)"/>
    <arg name="initial_y" value="$(arg initial_y)"/>
    <arg name="initial_yaw" value="$(arg initial_yaw)"/>
  </include>

  <!-- 3. 导航: 吃 /map + /lio_odom, 障碍走 /world_cloud 体素层 -->
  <include file="$(find rosiwit_navigation_ros1)/launch/navigation_simulation.launch">
    <arg name="config_file" value="$(arg navigation_config)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <!-- 4. 可选自动运动脚本 -->
  <node if="$(arg use_drive)"
        pkg="rosiwit_simulation_ros1" type="sim_drive.py"
        name="sim_drive" output="screen">
    <param name="mode" value="$(arg drive_mode)"/>
    <param name="linear_speed" value="$(arg drive_linear_speed)"/>
    <param name="angular_speed" value="$(arg drive_angular_speed)"/>
    <param name="duration" value="$(arg drive_duration)"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- 5. RViz -->
  <node if="$(arg rviz)"
        pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)" output="screen">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>
</launch>
