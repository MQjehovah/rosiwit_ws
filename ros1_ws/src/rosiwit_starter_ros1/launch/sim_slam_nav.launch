<?xml version="1.0"?>
<launch>
  <!--
    ROS1 仿真总入口（薄封装）：按参数决定起「世界侧」还是「算法侧」，或两边都起。

      # 1) 只起 Gazebo 世界（仿真容器用的就是这一档）
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch start_algo:=false

      # 2) 只起算法（SLAM + 导航 + 感知 + RViz），Gazebo 已经在别处跑
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch start_gazebo:=false \
                 map:=/ws/maps/parking

      # 3) 单机一把梭（默认）
      roslaunch rosiwit_starter_ros1 sim_slam_nav.launch scene:=parking

    两个真正的实现文件（也可以直接调）：
      world_only.launch   Gazebo 世界 + 机器人 + 行人 + 真值 2D 检测 + 行人走动
      algo_only.launch    3D 语义感知 + SLAM + 导航 + RViz

    分两边跑的前提是同一个 ROS master（WebIDE 里 ROS_MASTER_URI 指向仿真容器），
    这样改算法代码不用重启仿真；/clock、/scan、/camera_01/* 由世界侧提供。
  -->
  <arg name="start_gazebo" default="true"/>
  <arg name="start_algo" default="true"/>

  <!-- 世界侧 -->
  <arg name="scene" default="house"/>
  <arg name="world_name" default="$(find rosiwit_simulation_ros1)/world/$(arg scene).world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="0.1"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="person1_x" default="3.5"/>
  <arg name="person1_y" default="1.2"/>
  <arg name="person2_x" default="4.0"/>
  <arg name="person2_y" default="-0.6"/>
  <arg name="person3_x" default="5.0"/>
  <arg name="person3_y" default="1.2"/>
  <arg name="robot_name" default="mrobot"/>
  <arg name="lidar_plugin" default="velodyne"/>
  <!-- 世界侧感知：行人模型 + 真值检测 + 行人走动（关掉就没有行人和 GT） -->
  <arg name="enable_perception" default="true"/>
  <arg name="person_models" default="person_1,person_2,person_3"/>

  <!-- 算法侧 -->
  <arg name="slam_config" default="$(find rosiwit_slam_ros1)/config/simulation.yaml"/>
  <arg name="navigation_config" default="$(find rosiwit_navigation_ros1)/config/simulation.yaml"/>
  <arg name="map" default=""/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_yaw" default="0.0"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find rosiwit_starter_ros1)/rviz/sim_slam_nav.rviz"/>
  <!-- 算法侧感知：3D 语义（object_semantics）。默认跟随 enable_perception -->
  <arg name="algo_perception" default="$(arg enable_perception)"/>
  <arg name="perception_detector" default="external"/>
  <arg name="perception_config"
       default="$(find rosiwit_perception_ros1)/config/sim_object_semantics.yaml"/>

  <!-- 建图用的自动运动脚本（属于算法侧，往 /cmd_vel 发速度） -->
  <arg name="use_drive" default="false"/>
  <arg name="drive_mode" default="figure8"/>
  <arg name="drive_linear_speed" default="0.3"/>
  <arg name="drive_angular_speed" default="0.5"/>
  <arg name="drive_duration" default="120.0"/>

  <!-- 1. 世界侧 -->
  <include if="$(arg start_gazebo)"
           file="$(find rosiwit_starter_ros1)/launch/world_only.launch">
    <arg name="scene" value="$(arg scene)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="spawn_z" value="$(arg spawn_z)"/>
    <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
    <arg name="person1_x" value="$(arg person1_x)"/>
    <arg name="person1_y" value="$(arg person1_y)"/>
    <arg name="person2_x" value="$(arg person2_x)"/>
    <arg name="person2_y" value="$(arg person2_y)"/>
    <arg name="person3_x" value="$(arg person3_x)"/>
    <arg name="person3_y" value="$(arg person3_y)"/>
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="lidar_plugin" value="$(arg lidar_plugin)"/>
    <arg name="enable_perception" value="$(arg enable_perception)"/>
    <arg name="person_models" value="$(arg person_models)"/>
  </include>

  <!-- 2. 算法侧 -->
  <include if="$(arg start_algo)"
           file="$(find rosiwit_starter_ros1)/launch/algo_only.launch">
    <arg name="slam_config" value="$(arg slam_config)"/>
    <arg name="navigation_config" value="$(arg navigation_config)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="map" value="$(arg map)"/>
    <arg name="initial_x" value="$(arg initial_x)"/>
    <arg name="initial_y" value="$(arg initial_y)"/>
    <arg name="initial_yaw" value="$(arg initial_yaw)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
    <arg name="enable_perception" value="$(arg algo_perception)"/>
    <arg name="perception_detector" value="$(arg perception_detector)"/>
    <arg name="perception_config" value="$(arg perception_config)"/>
  </include>

  <!-- 3. 自动运动（建图辅助，属于算法侧；start_algo:=false 时别开） -->
  <node if="$(arg use_drive)"
        pkg="rosiwit_simulation_ros1" type="sim_drive.py"
        name="sim_drive" output="screen">
    <param name="mode" value="$(arg drive_mode)"/>
    <param name="linear_speed" value="$(arg drive_linear_speed)"/>
    <param name="angular_speed" value="$(arg drive_angular_speed)"/>
    <param name="duration" value="$(arg drive_duration)"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>
</launch>
