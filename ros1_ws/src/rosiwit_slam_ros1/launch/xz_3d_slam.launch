<launch>

  <arg name="marker_size" default="9.0" />
	<arg name="max_new_marker_error" default="0.08" />
	<arg name="max_track_error" default="0.2" />
	<arg name="cam_image_topic" default="/camera_01/color/image_raw" />
	<arg name="cam_info_topic" default="/camera_01/color/camera_info" />
	<arg name="output_frame" default="/map" />

  <node pkg="xzrobot_slam" name="abot_odom" type="abot_odom.py" respawn="true" clear_params="true" output="screen"/>

  <node pkg="map_converter" name="map_converter" type="map_converter" respawn="true" clear_params="true" output="screen">
  <remap from="/scan_f_map" to="/scan_f_map_unused"/>
  </node>

  <include file="$(find robot_localization)/launch/slip_sensitive.launch" />

  <include file="$(find whether_slip)/launch/whether_slip.launch" />  

  <node name="ar_track_alvar" pkg="ar_track_alvar" type="individualMarkersNoKinect" respawn="false" output="screen">
    <param name="marker_size"           type="double" value="$(arg marker_size)" />
    <param name="max_new_marker_error"  type="double" value="$(arg max_new_marker_error)" />
    <param name="max_track_error"       type="double" value="$(arg max_track_error)" />
    <param name="output_frame"          type="string" value="$(arg output_frame)" />

    <remap from="camera_image"  to="$(arg cam_image_topic)" />
    <remap from="camera_info"   to="$(arg cam_info_topic)" />
  </node>

    <!-- <include file="$(find robot_pose_ekf)/launch/xzrobot_odom_imu_combine.launch"/> -->

    <!-- <node name="ar_track_alvar" pkg="ar_track_alvar" type="individualMarkersNoKinect" respawn="false" output="screen">
      <param name="marker_size"           type="double" value="$(arg marker_size)" />
      <param name="max_new_marker_error"  type="double" value="$(arg max_new_marker_error)" />
      <param name="max_track_error"       type="double" value="$(arg max_track_error)" />
      <param name="output_frame"          type="string" value="$(arg output_frame)" />

      <remap from="camera_image"  to="$(arg cam_image_topic)" />
      <remap from="camera_info"   to="$(arg cam_info_topic)" />
    </node>

    <node name="tag_detected_dev" pkg="tag_detected_dev" type="tag_detected_dev_node" respawn="false" output="screen">
      <param name="charging_waiting_distance"       type="double" value="2.0" />
    </node> -->

    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find xzrobot_slam)/rviz/robot_2d.rviz"/> -->
    
    <!-- <node name="xz_3d_slam_node" pkg="xz_3d_slam" type="xz_3d_slam_node" output="screen"> -->

    <node name="xz_3d_monitor" pkg="xz_3d_monitor" type="xz_3d_monitor_node" output="log"> </node>
    <!-- drop-in: 唯一改动就是把下面这行的 pkg/type 指向本包。
         节点名必须保持 xz_3d_slam —— 这是机器人上 xzrobot_all / xz_3d_monitor 依赖的部署名。 -->
    <node name="xz_3d_slam" pkg="rosiwit_slam_ros1" type="rosiwit_slam_ros1_node" output="log">
      <param name="config_file" value="$(find rosiwit_slam_ros1)/config/default.yaml" />
    </node>

</launch>
