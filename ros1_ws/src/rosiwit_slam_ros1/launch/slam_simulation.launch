<?xml version="1.0"?>
<launch>
  <!--
    ROS1 SLAM 仿真启动 (rosiwit_simulation_ros1 / Gazebo)。

    输入/输出:
      - 输入: /velodyne_points (VLP-16) + /imu
      - TF:   map -> odom (本节点, 动态); odom -> base_footprint 由 Gazebo 差速插件发布
      - 输出: /map, /lio_odom, /world_cloud, /cloud_map, /slam/info ...

    本文件只启动 SLAM 节点, 不拉起 Gazebo。单独使用:
      roslaunch rosiwit_simulation_ros1 simulator_gazebo.launch
      roslaunch rosiwit_slam_ros1 slam_simulation.launch
    一键仿真 (Gazebo + SLAM + 导航): roslaunch rosiwit_starter_ros1 sim_slam_nav.launch

    参数:
      - config/simulation.yaml     核心参数 (帧、话题、mapping/localization、栅格)
      - conf/sim_slam_conf.json    旧接口 JSON (只负责选择 ROS1 输入话题)
      - map_yaml                   非空则启动后载入该地图并切定位模式:
                                     roslaunch ... map_yaml:=$HOME/rosiwit_ws/docs/maps/map/map.yaml
  -->
  <arg name="slam_algorithm" default="fast_lio2_pipeline"/>
  <arg name="config_file" default="$(find rosiwit_slam_ros1)/config/simulation.yaml"/>
  <arg name="legacy_conf_file" default="$(find rosiwit_slam_ros1)/conf/sim_slam_conf.json"/>
  <arg name="lidar_frame" default="lidar"/>
  <arg name="imu_frame" default="imu_link"/>
  <arg name="base_frame" default="base_footprint"/>
  <!-- Gazebo 下必须为 true: 节点跟随 /clock 计时, 否则 TF/数据时间戳与仿真脱节 -->
  <arg name="use_sim_time" default="true"/>

  <!-- 已有地图: load_map=false 时保持建图; 否则载入 map_yaml 并切 localization -->
  <arg name="load_map" default="true"/>
  <arg name="map_yaml" default=""/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_yaw" default="0.0"/>

  <node pkg="rosiwit_slam_ros1" type="rosiwit_slam_ros1_node" name="rosiwit_slam" output="screen">
    <param name="slam_algorithm" value="$(arg slam_algorithm)"/>
    <param name="config_file" value="$(arg config_file)"/>
    <param name="legacy_conf_file" value="$(arg legacy_conf_file)"/>
    <param name="lidar_frame" value="$(arg lidar_frame)"/>
    <param name="imu_frame" value="$(arg imu_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- 地图存在就载入并切定位模式; 不存在时只告警, 保持建图 -->
  <node if="$(eval arg('load_map') and arg('map_yaml') != '')"
        pkg="rosiwit_slam_ros1" type="load_saved_map.py"
        name="load_saved_map" output="screen">
    <param name="map_yaml" value="$(arg map_yaml)"/>
    <param name="initial_x" value="$(arg initial_x)"/>
    <param name="initial_y" value="$(arg initial_y)"/>
    <param name="initial_yaw" value="$(arg initial_yaw)"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>
</launch>
