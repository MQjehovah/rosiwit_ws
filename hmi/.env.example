# 复制成 .env.local 后填写（.env.local 不会提交）
#
# 设备局域网 rosbridge（默认）
# VITE_ROSBRIDGE_URL=ws://192.168.1.100:8089
#
# 远程隧道（https 页面下必须用 wss）
# VITE_TUNNEL_URL=wss://test.rosiwit.com/remote-terminal/tunnel/<SN>/<TOKEN>/127.0.0.1/8089/
# VITE_ROSBRIDGE_URL=wss://test.rosiwit.com/remote-terminal/tunnel/<SN>/<TOKEN>/127.0.0.1:8089/
