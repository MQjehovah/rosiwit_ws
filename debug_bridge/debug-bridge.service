[Unit]
Description=rosiwit debug_bridge
After=network.target xzrobot.service
Wants=xzrobot.service
PartOf=xzrobot.service

[Service]
User=xzrobot
Environment=PYTHONUNBUFFERED=1
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
ExecStart=/bin/bash -lc "source /opt/ros/melodic/setup.bash && source /home/xzrobot/rosiwit_build/ros1_ws/devel/setup.bash && exec python /home/xzrobot/debug_bridge/debug_bridge.py --port 9100"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
